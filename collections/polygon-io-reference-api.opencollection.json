{
  "opencollection": "1.0.0",
  "info": {
    "name": "Polygon.io REST API (Stocks) Aggregates Reference API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apiKey",
      "value": "{{apiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reference",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List ticker symbols",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.polygon.io/v3/reference/tickers",
            "params": [
              {
                "name": "ticker",
                "value": "",
                "type": "query",
                "description": "Filter by specific ticker symbol."
              },
              {
                "name": "type",
                "value": "",
                "type": "query"
              },
              {
                "name": "market",
                "value": "",
                "type": "query"
              },
              {
                "name": "exchange",
                "value": "",
                "type": "query"
              },
              {
                "name": "active",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve a comprehensive list of ticker symbols supported across asset classes."
        },
        {
          "info": {
            "name": "Get ticker details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.polygon.io/v3/reference/tickers/:ticker",
            "params": [
              {
                "name": "ticker",
                "value": "",
                "type": "path"
              },
              {
                "name": "date",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Retrieve detailed reference information for a single ticker symbol."
        }
      ]
    }
  ],
  "bundled": true
}